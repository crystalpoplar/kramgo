[Unit]
Description=Kramgo Ollama watchdog
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/dtk1376
ExecStart=/home/dtk1376/kramgo-watchdog --ollama-url http://127.0.0.1:11434 --model crystal:latest --service-name ollama --interval 10m --max-failures 3 --prompt "Return exactly the word OK and nothing else." --rebuild-model --modelfile /home/dtk1376/Modelfile
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
